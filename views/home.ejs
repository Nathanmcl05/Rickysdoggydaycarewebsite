<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Ricky's Doggy Daycare</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <!-- Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

  <style>
    :root {
      --blue: #bbd8ee;
      --yellow: #ffc767;
      --white: #ffffff;
      --light-blue: #e3f2fd;
      --dark-blue: #1565c0;
      --gray: #f5f5f5;
      --text-dark: #333;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: Arial, Helvetica, sans-serif;
    }

    body {
      background-color: var(--light-blue);
      color: var(--text-dark);
      line-height: 1.6;
    }

    header {
      background-image: url("/images/background.jpg");
      background-size: cover;
      background-position: center;
      text-align: center;
      padding: 60px 20px;
    }

    nav {
      background-color: var(--blue);
      display: flex;
      justify-content: center;
      gap: 30px;
      padding: 15px;
    }

    nav a {
      color: white;
      text-decoration: none;
      font-weight: bold;
    }

    main {
      max-width: 1100px;
      margin: auto;
      padding: 40px 20px;
    }

    section {
      background: white;
      padding: 30px;
      border-radius: 12px;
      margin-bottom: 30px;
      box-shadow: 0 8px 20px rgba(0,0,0,0.1);
    }

    .services {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 20px;
    }

    .service-card {
      background: var(--gray);
      padding: 20px;
      border-radius: 10px;
      text-align: center;
      transition: 0.3s;
    }

    .service-card:hover {
      transform: translateY(-5px);
      background: var(--yellow);
    }

    .gallery-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 15px;
      margin-top: 20px;
    }

    .gallery-grid img {
      width: 100%;
      height: 200px;
      object-fit: cover;
      border-radius: 12px;
    }

    footer {
      background: var(--blue);
      color: white;
      text-align: center;
      padding: 20px;
    }
  </style>
</head>

<body>

<header>
  <img src="/images/rickys.png" alt="Ricky's Doggy Daycare Logo">
</header>

<nav>
  <a href="/about"><i class="fa-solid fa-paw"></i> About</a>
  <a href="/booking"><i class="fa-solid fa-bone"></i> Booking</a>
  <a href="#contact"><i class="fa-solid fa-phone"></i> Contact</a>
  <a href="/log"><i class="fa-solid fa-user"></i> Login</a>
  <a href="#gallery"><i class="fa-solid fa-images"></i> Gallery</a>
</nav>

<main>

<section>
  <h2><i class="fa-solid fa-heart"></i> About Us</h2>
  <p>
    At Ricky’s Doggy Daycare, we provide a safe, fun, and loving environment where dogs feel right at home 🐾
  </p>
</section>

<section>
  <h2><i class="fa-solid fa-paw"></i> Our Services</h2>

  <div class="services">
    <a href="/booking?service=Daycare" class="service-card">
      <i class="fa-solid fa-dog"></i>
      <h3>Daycare</h3>
      <p>Supervised play all day</p>
    </a>

    <a href="/booking?service=Overnight Boarding" class="service-card">
      <i class="fa-solid fa-house"></i>
      <h3>Overnight Boarding</h3>
      <p>Cozy overnight stays</p>
    </a>

    <a href="/booking?service=Grooming" class="service-card">
      <i class="fa-solid fa-scissors"></i>
      <h3>Grooming</h3>
      <p>Baths, trims & care</p>
    </a>
  </div>
</section>

<section id="gallery">
  <h2><i class="fa-solid fa-camera"></i> Gallery</h2>

  <div class="gallery-grid">
    <img src="/images/dog1.jpg">
    <img src="/images/dog2.jpg">
    <img src="/images/dog3.jpg">
    <img src="/images/dog4.webp">
    <img src="/images/dog5.jpg">
    <img src="/images/dog6.jpg">
  </div>
</section>

<section id="contact">
  <h2><i class="fa-solid fa-envelope"></i> Contact Us</h2>
  <p>📧 info@ricksdoggydaycare.com</p>
  <p>📞 (555) 123-4567</p>
</section>

</main>

<footer>
  <p>🐾 © 2026 Ricky's Doggy Daycare</p>
</footer>

<!-- ✅ NOUPE CHATBOT (ONLY ONE) -->
<script src="https://www.noupe.com/embed/019bd6cb2af97e62917f8a59ff0bd431fc51.js"></script>

</body>
</html>
