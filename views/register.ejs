<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Register - Ricky's Doggy Daycare</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

  <style>
    :root {
      --blue: #bbd8ee;
      --yellow: #ffc767;
      --white: #ffffff;
      --light-blue: #e3f2fd;
      --dark-blue: #1565c0;
      --gray: #f5f5f5;
      --text-dark: #333;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: Arial, Helvetica, sans-serif;
    }

    body {
      background-image: url('/images/background.jpg');
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;

      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
    }

    .register-container {
      background-color: var(--white);
      border-radius: 15px;
      width: 400px;
      padding: 40px 30px;
      box-shadow: 0 10px 25px rgba(0,0,0,0.15);
      text-align: center;
    }

    .register-container img {
      width: 120px;
      margin-bottom: 20px;
    }

    .register-container h1 {
      color: var(--blue);
      margin-bottom: 10px;
      font-size: 1.8rem;
    }

    .register-container h3 {
      color: var(--text-dark);
      margin-bottom: 30px;
      font-weight: normal;
    }

    .register-container label {
      display: block;
      text-align: left;
      margin-bottom: 5px;
      color: var(--text-dark);
      font-weight: bold;
      margin-left: 5%;
    }

    .register-container input {
      display: block;
      width: 90%;
      margin: 0 auto 20px auto;
      padding: 10px;
      border: 1px solid var(--gray);
      border-radius: 8px;
      font-size: 1rem;
    }

    .register-container button {
      background-color: var(--blue);
      color: var(--white);
      border: none;
      padding: 12px 0;
      width: 95%;
      border-radius: 25px;
      font-size: 1rem;
      cursor: pointer;
      transition: background 0.3s;
    }

    .register-container button:hover {
      background-color: var(--dark-blue);
    }

    .register-container p {
      margin-top: 20px;
      font-size: 0.9rem;
    }

    .register-container p a {
      color: var(--blue);
      text-decoration: none;
      font-weight: bold;
    }

    @media(max-width: 450px){
      .register-container {
        width: 90%;
        padding: 30px 20px;
      }
    }
  </style>
</head>

<body>

  <div class="register-container">
    <img src="/images/rickys.png" alt="Ricky's Doggy Daycare Logo">
    <h1>Create Account</h1>
    <h3>Join Ricky’s Doggy Daycare</h3>

    <form action="/register" method="POST">
      <label for="name"><i class="fa-solid fa-user"></i> Full Name</label>
      <input type="text" id="name" name="name" placeholder="Enter your full name" required>

      <label for="email"><i class="fa-solid fa-envelope"></i> Email</label>
      <input type="email" id="email" name="email" placeholder="Enter your email" required>

      <label for="password"><i class="fa-solid fa-lock"></i> Password</label>
      <input type="password" id="password" name="password" placeholder="Create a password" required>

      <label for="confirm-password"><i class="fa-solid fa-lock"></i> Confirm Password</label>
      <input type="password" id="confirm-password" name="confirm_password" placeholder="Confirm your password" required>

      <button type="submit">
        <i class="fa-solid fa-user-plus"></i> Register
      </button>
    </form>

    <p>Already have an account? <a href="/login">Login</a></p>
  </div>

</body>
</html>
