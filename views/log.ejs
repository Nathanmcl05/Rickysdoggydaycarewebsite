<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Login - Ricky's Doggy Daycare</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

  <style>
    :root {
      --blue: #bbd8ee;
      --yellow: #ffc767;
      --white: #ffffff;
      --dark-blue: #1565c0;
      --gray: #f5f5f5;
      --text-dark: #333;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: Arial, Helvetica, sans-serif;
    }

    body {
      background-image: url('/images/background.jpg');
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
      min-height: 100vh;
    }

    /* ===== NAV ===== */
    nav {
      background-color: var(--blue);
      display: flex;
      justify-content: center;
      gap: 30px;
      padding: 15px;
      position: sticky;
      top: 0;
      z-index: 1000;
    }

    nav a {
      color: var(--white);
      text-decoration: none;
      font-weight: bold;
    }

    nav a i {
      margin-right: 6px;
    }

    /* ===== CENTERING WRAPPER ===== */
    .login-wrapper {
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: calc(100vh - 70px);
      padding: 20px;
    }

    /* ===== LOGIN BOX ===== */
    .login-container {
      background-color: var(--white);
      border-radius: 15px;
      width: 400px;
      padding: 40px 30px;
      box-shadow: 0 10px 25px rgba(0,0,0,0.15);
      text-align: center;
    }

    .login-container img {
      width: 120px;
      margin-bottom: 20px;
    }

    .login-container h1 {
      color: var(--blue);
      margin-bottom: 10px;
      font-size: 1.8rem;
    }

    .login-container h3 {
      color: var(--text-dark);
      margin-bottom: 30px;
      font-weight: normal;
    }

    .login-container label {
      display: block;
      text-align: left;
      margin-bottom: 5px;
      font-weight: bold;
      margin-left: 5%;
    }

    .login-container input {
      width: 90%;
      margin: 0 auto 20px auto;
      padding: 10px;
      border: 1px solid var(--gray);
      border-radius: 8px;
      font-size: 1rem;
    }

    .login-container button {
      background-color: var(--blue);
      color: var(--white);
      border: none;
      padding: 12px 0;
      width: 95%;
      border-radius: 25px;
      font-size: 1rem;
      cursor: pointer;
      transition: background 0.3s;
    }

    .login-container button:hover {
      background-color: var(--dark-blue);
    }

    .login-container p {
      margin-top: 20px;
      font-size: 0.9rem;
    }

    .login-container p a {
      color: var(--blue);
      text-decoration: none;
      font-weight: bold;
    }

    /* ===== MOBILE ===== */
    @media (max-width: 450px) {
      .login-container {
        width: 90%;
        padding: 30px 20px;
      }
    }
  </style>
</head>

<body>

  <!-- NAV -->
   <nav>
  <a href="/about"><i class="fa-solid fa-paw"></i>About</a>
  <a href="/booking"><i class="fa-solid fa-bone"></i>Booking</a>
  <a href="#contact"><i class="fa-solid fa-phone"></i>Contact</a>
  <a href="/log"><i class="fa-solid fa-user"></i> Login</a>
  <a href="#gallery"><i class="fa-solid fa-images"></i>Gallery</a>
    <a href="/location"><i class="fa-solid fa-images"></i>location</a>
</nav>
  <!-- CENTERED LOGIN -->
  <div class="login-wrapper">
    <div class="login-container">
      <img src="/images/rickys.png" alt="Ricky's Doggy Daycare Logo">

      <h1>Welcome Back!</h1>
      <h3>Login to your account</h3>

      <form action="/login" method="POST">
        <label for="email">
          <i class="fa-solid fa-envelope"></i> Email
        </label>
        <input type="email" id="email" name="email" required>

        <label for="password">
          <i class="fa-solid fa-lock"></i> Password
        </label>
        <input type="password" id="password" name="password" required>

        <button type="submit">
          <i class="fa-solid fa-right-to-bracket"></i> Login
        </button>
      </form>

      <p>
        Not registered?
        <a href="/register">Create an account</a>
      </p>
    </div>
  </div>

</body>
</html>
